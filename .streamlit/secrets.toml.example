# Copy this file to `.streamlit/secrets.toml` (which is gitignored) and fill in
# your keys. On Streamlit Community Cloud, paste the same keys under
# Manage app → Settings → Secrets. Then Reboot the app.

# ── AI Analyst ───────────────────────────────────────────────────────
# Powers the "Vettd AI Analyst" section on the report. Set EITHER key below.
# Without either, the app falls back to the built-in rule-based report —
# everything still works, just no AI section.

# OPTION A — FREE (recommended): Google Gemini free tier, no credit card.
#   Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY = "your-free-gemini-key"
# GEMINI_MODEL = "gemini-3.6-flash"   # optional override (default shown)

# OPTION B — PAID (premium quality): Anthropic Claude, ~2c per report.
#   Get a key at https://console.anthropic.com/  (model: claude-sonnet-5)
# ANTHROPIC_API_KEY = "sk-ant-..."

# ── Live creator data (Instagram) ────────────────────────────────────
# RapidAPI "Instagram Scraper Stable API" powers the "Fetch live data" button.
RAPIDAPI_KEY = "your-rapidapi-key"
RAPIDAPI_HOST = "instagram-scraper-stable-api.p.rapidapi.com"

# Optional — Modash (full audience demographics). Leave unset if not subscribed.
# MODASH_API_KEY = "your-modash-key"

# Optional — Formspree ID for the Contact form (else it falls back to mailto).
# FORMSPREE_ID = "your-formspree-id"
